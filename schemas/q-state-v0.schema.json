{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gatekeeper454/KIL/schemas/q-state-v0.schema.json",
  "title": "KIL experimental composite enforcement state v0",
  "description": "Experimental KIL extension payload referencing KTP v2.0.0 Trust Proof and Kinetic Envelope artifacts; not a KTP v2.0.0 wire artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "state_id",
    "issuer",
    "subject",
    "audience",
    "authority_class",
    "action_class",
    "issued_at_s",
    "not_before_s",
    "expires_at_s",
    "evidence_horizon_s",
    "trust_proof_id",
    "trust_proof_digest",
    "envelope_result_id",
    "envelope_result_digest",
    "deployment_profile",
    "charge",
    "threshold",
    "history_count",
    "minimum_history",
    "veto_clear",
    "envelope_allows",
    "decay_rate",
    "maximum_charge",
    "model_version",
    "parameter_version"
  ],
  "properties": {
    "schema_version": {"const": "kil.q-state.v0"},
    "state_id": {"type": "string", "minLength": 1},
    "issuer": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1},
    "audience": {"type": "string", "minLength": 1},
    "authority_class": {"type": "string", "minLength": 1},
    "action_class": {"type": "string", "minLength": 1},
    "issued_at_s": {"type": "integer"},
    "not_before_s": {"type": "integer"},
    "expires_at_s": {"type": "integer"},
    "evidence_horizon_s": {"type": "integer"},
    "trust_proof_id": {"type": "string", "minLength": 1},
    "trust_proof_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "envelope_result_id": {"type": "string", "minLength": 1},
    "envelope_result_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "deployment_profile": {"type": "string", "minLength": 1},
    "charge": {"type": "string", "maxLength": 64, "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"},
    "threshold": {"type": "string", "maxLength": 64, "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"},
    "history_count": {"type": "integer", "minimum": 0},
    "minimum_history": {"type": "integer", "minimum": 0},
    "veto_clear": {"type": "boolean"},
    "envelope_allows": {"type": "boolean"},
    "decay_rate": {"type": "string", "maxLength": 64, "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"},
    "maximum_charge": {"type": "string", "maxLength": 64, "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"},
    "model_version": {"type": "string", "minLength": 1},
    "parameter_version": {"type": "string", "minLength": 1}
  }
}
